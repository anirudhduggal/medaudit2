# =============================================================================
# Medaudit 2.0 - .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
MANIFEST
.installed.cfg

# ---- Virtual Environments ----
.env
.venv
env/
venv/
ENV/

# ---- Distribution / Packaging ----
.Python
build/
dist/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
develop-eggs/
downloads/

# ---- Testing ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
.hypothesis/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
tests/logs/
tests/results/
tests/.pytest_cache/
tests/__pycache__/

# ---- Type Checkers ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Java / Gradle (Burp Extension) ----
burp-extension/build/
burp-extension/.gradle/
burp-extension/lib/*.jar
*.class

# ---- Docker ----
docker-compose.override.yml

# =============================================================================
# Medaudit Runtime Data (generated at runtime, never commit)
# =============================================================================

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# At-rest encryption key for stored secrets -- MUST NOT be committed
# (committing it alongside the DB would defeat encryption at rest)
.secret_key
**/.secret_key

# Runtime logs
logs/
**/logs/
*.log
*.jsonl

# Project artifacts (PCAPs, reports, fuzzing results)
medaudit/data/artifacts/
medaudit/data/fuzzing_logs/
artifacts/
*.pcap.processed

# Temporary files
*.tmp
*.bak
*.orig
*.json.tmp

# Local config overrides
.env.local
.env.*.local
config.local.json
hl7server.local.json

# Session files
*.session
session_*
